# Copy to .env for local development. Never commit real secrets.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<local anon key from `npm run db:start`>
VITE_PUBLIC_SITE_URL=http://127.0.0.1:4173

# Server-only — used by scripts/create-admin.mjs and scripts/run-seed.mjs
SUPABASE_SERVICE_ROLE_KEY=<service_role key>
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=<strong password>
