{
  "name": "wavesign-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WaveSign Studio — public site + Supabase-backed admin panel",
  "scripts": {
    "admin:dev": "vite --config admin-src/vite.config.ts",
    "admin:build": "vite build --config admin-src/vite.config.ts",
    "admin:preview": "vite preview --config admin-src/vite.config.ts",
    "admin:typecheck": "tsc -p admin-src/tsconfig.json --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "seed:build": "node scripts/build-seed.mjs",
    "setup:sql": "node scripts/build-setup-sql.mjs",
    "create-admin": "node scripts/create-admin.mjs",
    "serve": "node scripts/dev-server.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "supabase": "^1.207.9",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.1",
    "@supabase/supabase-js": "^2.46.1",
    "@tanstack/react-query": "^5.59.20",
    "@tiptap/extension-link": "^2.9.1",
    "@tiptap/extension-placeholder": "^2.9.1",
    "@tiptap/pm": "^2.9.1",
    "@tiptap/react": "^2.9.1",
    "@tiptap/starter-kit": "^2.9.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.456.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-router-dom": "^6.28.0",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  }
}
